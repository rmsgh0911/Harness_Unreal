{
  "version": 1,
  "purpose": "agent_created_tool_registry",
  "policy": {
    "default_directory": "Harness/scripts/tools",
    "safe_by_default": true,
    "prefer_read_only_default": true,
    "write_options_must_be_explicit": true,
    "project_specific_values_source": "Harness/config/project.json"
  },
  "tools": [
    {
      "name": "harness_docs_check",
      "path": "Harness/scripts/tools/harness_docs_check.py",
      "purpose": "Checks Harness/docs, Harness/config/docs.json, on-demand reading policy, and whether a request should read project docs.",
      "inputs": [
        "Harness/config/docs.json",
        "Harness/docs/README.md",
        "--request"
      ],
      "outputs": [
        "docs_policy_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_docs_check.py --json"
    },
    {
      "name": "harness_sensitive_check",
      "path": "Harness/scripts/tools/harness_sensitive_check.py",
      "purpose": "Scans long-lived Harness text for high-confidence credentials and ambiguous assignments without returning matched values.",
      "inputs": [
        "AGENTS.md, CLAUDE.md, HARNESS.md, README.md",
        "Harness/config/sensitive_allowlist.json",
        "Harness/config, docs, index, work, and reviewed memory text",
        "--strict"
      ],
      "outputs": [
        "redacted_sensitive_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_sensitive_check.py --json"
    },
    {
      "name": "harness_artifact_check",
      "path": "Harness/scripts/tools/harness_artifact_check.py",
      "purpose": "Validates generated-artifact provenance, safe paths, matching revisions, source/output SHA-256 integrity, evidence scope, and acceptance; legacy missing source hashes warn and block strict checks.",
      "inputs": [
        "Harness/config/generated_artifacts.json",
        "registered source and output paths",
        "--strict"
      ],
      "outputs": [
        "generated_artifact_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_artifact_check.py --json"
    },
    {
      "name": "harness_cli",
      "path": "Harness/scripts/tools/harness_cli.py",
      "purpose": "Routes every registered standard tool through PowerShell and POSIX managed-runtime aliases, keeps the batch wrapper to fixed-token convenience calls, and provides an explicit managed-Python bootstrap while normal commands disable implicit Python Install Manager downloads.",
      "inputs": [
        "Harness/bootstrap.ps1",
        "Harness/bootstrap.sh",
        "Harness/harness.cmd",
        "Harness/harness.ps1",
        "Harness/harness.sh",
        "HARNESS_PYTHON",
        "HARNESS_UV",
        "HARNESS_RUNTIME_ROOT",
        "HARNESS_UV_CACHE_DIR",
        "UV_CACHE_DIR",
        "PYTHON_MANAGER_AUTOMATIC_INSTALL",
        "subcommand arguments"
      ],
      "outputs": [
        "delegated tool output",
        "delegated exit code",
        "platform-local Harness/.runtime only with explicit launcher bootstrap"
      ],
      "writes_files": "only_when_the_selected_subcommand_writes_or_explicit_launcher_bootstrap_is_requested",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_cli.py --help"
    },
    {
      "name": "harness_template_manifest",
      "path": "Harness/scripts/tools/harness_template_manifest.py",
      "purpose": "Builds and verifies the deterministic release inventory, file hashes, and template/project ownership rules.",
      "inputs": [
        "Harness/template/manifest.json",
        "releasable template files",
        "--write"
      ],
      "outputs": [
        "manifest_status",
        "atomically refreshed manifest only with --write",
        "json"
      ],
      "writes_files": "only_with_--write",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_template_manifest.py --json"
    },
    {
      "name": "harness_context",
      "path": "Harness/scripts/tools/harness_context.py",
      "purpose": "Prints a short task-start briefing with scoped Korean/English Harness-update routing, active local rules, request-related next items, and priority-aware knowledge hints.",
      "inputs": [
        "HARNESS.md",
        "Harness/work/state.md",
        "Harness/work/next.md",
        "Harness/work/tasks/<task-id>.md",
        "Harness/work/cycles/<task-id>.md",
        "Harness/config/project.json",
        "Harness/config/docs.json",
        "Harness/config/local_rules.md",
        "Harness/config/cycle_policy.json",
        "Harness/scripts/tools/tool_manifest.json",
        "--request",
        "--all-next"
      ],
      "outputs": [
        "short_text",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_context.py --json"
    },
    {
      "name": "harness_doctor",
      "path": "Harness/scripts/tools/harness_doctor.py",
      "purpose": "Checks whether Harness documents, config files, and the tool manifest are consistent.",
      "inputs": [
        "HARNESS.md",
        "AGENTS.md",
        "CLAUDE.md",
        "Harness/config/*.json",
        "Harness/scripts/tools/tool_manifest.json"
      ],
      "outputs": [
        "check_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_doctor.py --json"
    },
    {
      "name": "harness_scan",
      "path": "Harness/scripts/tools/harness_scan.py",
      "purpose": "Scans Unreal project structure and summarizes project.json candidates plus key Source, Config, and Plugin information.",
      "inputs": [
        "*.uproject",
        "Source/**/*.Build.cs",
        "Source/**/*Target.cs",
        "Config/*.ini",
        "Plugins/**/*.uplugin",
        "Content/**/*.umap with --include-assets"
      ],
      "outputs": [
        "scan_summary",
        "project_json_candidate",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_scan.py --json"
    },
    {
      "name": "harness_archive",
      "path": "Harness/scripts/tools/harness_archive.py",
      "purpose": "Previews or transactionally archives completed task/cycle pairs by task ID, or date-named cycle files older than a given month, into validated monthly folders with a searchable index and rollback on failed moves.",
      "inputs": [
        "--task",
        "--before",
        "--month",
        "--archive",
        "Harness/work/tasks/<task-id>.md",
        "Harness/work/cycles/<task-id>.md",
        "Harness/work/cycles/*<YYYY-MM-DD>*.md"
      ],
      "outputs": [
        "archive_plan",
        "monthly archive and index only with --archive"
      ],
      "writes_files": "only_with_--archive",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_archive.py --help"
    },
    {
      "name": "harness_iteration_status",
      "path": "Harness/scripts/tools/harness_iteration_status.py",
      "purpose": "Reports cycle progress, remaining budget, missing verification or evidence acceptance, repeated unresolved work, and stop recommendations without changing files.",
      "inputs": [
        "--request",
        "--task",
        "Harness/config/cycle_policy.json",
        "Harness/work/cycles/<task-id>.md"
      ],
      "outputs": [
        "iteration_status",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_iteration_status.py --request \"up to 3 cycles\" --json"
    },
    {
      "name": "harness_work",
      "path": "Harness/scripts/tools/harness_work.py",
      "purpose": "Previews verified task closeout and, only with --write, marks the task completed and archives its task/cycle pair with rollback on failure.",
      "inputs": [
        "--task",
        "--month",
        "--write",
        "Harness/work/tasks/<task-id>.md",
        "Harness/work/cycles/<task-id>.md"
      ],
      "outputs": [
        "closeout_plan",
        "monthly archive and index only with --write",
        "json"
      ],
      "writes_files": "only_with_--write",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_work.py --help"
    },
    {
      "name": "harness_cycle",
      "path": "Harness/scripts/tools/harness_cycle.py",
      "purpose": "Creates and validates a structured cycle entry with optional claims, evidence, revisions, artifacts, acceptance, invalidation, and supersession; appends only with explicit --write.",
      "inputs": [
        "title",
        "--changed",
        "--verified",
        "--remaining",
        "--cycle-number",
        "--max-cycles",
        "--budget-mode",
        "--decision",
        "--success-criterion",
        "--claim",
        "--evidence-kind",
        "--evidence-command",
        "--evidence-exit-code",
        "--artifact",
        "--input-revision",
        "--artifact-revision",
        "--scope",
        "--acceptance",
        "--supersedes",
        "--invalidated",
        "--date",
        "--task",
        "--worker",
        "--write"
      ],
      "outputs": [
        "cycle_log_entry"
      ],
      "writes_files": "only_with_--write",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_cycle.py tool_check --task tool-check --worker Codex --changed dry_run --verified json --json"
    },
    {
      "name": "harness_diff_guard",
      "path": "Harness/scripts/tools/harness_diff_guard.py",
      "purpose": "Summarizes risky Unreal change scope from git status and generated-directory detection, and warns when meaningful project changes lack a Progress.md update.",
      "inputs": [
        "git status --short when available",
        "Binaries/",
        "Intermediate/",
        "Saved/",
        "DerivedDataCache/",
        "changed Source headers and Build.cs files",
        "Harness/Progress.md"
      ],
      "outputs": [
        "risk_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_diff_guard.py --json"
    },
    {
      "name": "harness_field_check",
      "path": "Harness/scripts/tools/harness_field_check.py",
      "purpose": "Checks field-proven Harness operating risks: missing field guide, wrong project-root signals, suspicious text artifacts, nested Harness review copies, Unreal Python wrapper hints, current checkout/worktree visibility, and optional remote branch-ref alignment.",
      "inputs": [
        "Harness/docs/AgentFieldGuide.md",
        "HARNESS.md",
        "Harness/README.md",
        "Harness/docs/README.md",
        "Harness/config/project.json",
        "Harness/scripts/unreal/*.py",
        "git status --short --branch",
        "git worktree list --porcelain",
        "--branches"
      ],
      "outputs": [
        "field_risk_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_field_check.py --json"
    },
    {
      "name": "harness_handoff",
      "path": "Harness/scripts/tools/harness_handoff.py",
      "purpose": "Creates a minimal task-aware handoff with filtered next work and iteration progress as a dry run, and writes only with explicit --write.",
      "inputs": [
        "harness_context",
        "harness_diff_guard",
        "Harness/work/next.md",
        "Harness/work/tasks/<task-id>.md",
        "Harness/work/cycles/<task-id>.md",
        "--request",
        "--write"
      ],
      "outputs": [
        "handoff_markdown"
      ],
      "writes_files": "only_with_--write",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_handoff.py --request \"verification\""
    },
    {
      "name": "harness_subagent",
      "path": "Harness/scripts/tools/harness_subagent.py",
      "purpose": "Validates provider-neutral read-only helper roles and emits bounded current-status or staged-commit delegation packets without spawning an agent or writing files.",
      "inputs": [
        "Harness/config/agents.json",
        "Harness/agents/*.md",
        "harness_context",
        "harness_diff_guard",
        "git status and diff metadata",
        "--role",
        "--request",
        "--task",
        "--verification",
        "--include-staged-patch",
        "--max-patch-chars",
        "--max-staged-paths",
        "--expected-snapshot"
      ],
      "outputs": [
        "subagent_delegation_packet",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_subagent.py --role current-status --json"
    },
    {
      "name": "harness_verify_all",
      "path": "Harness/scripts/tools/harness_verify_all.py",
      "purpose": "Runs standard end-of-task checks including generated-artifact provenance, sensitive data, project/build readiness, tool tests, and strict release hygiene in template mode.",
      "inputs": [
        "harness_doctor",
        "harness_context",
        "harness_scan",
        "harness_diff_guard",
        "harness_field_check",
        "harness_artifact_check",
        "Harness/config/*.json",
        "Harness/scripts/**/*.py",
        "--skip-tool-tests"
      ],
      "outputs": [
        "verification_bundle_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_verify_all.py --json --skip-tool-tests"
    },
    {
      "name": "harness_local_gate",
      "path": "Harness/scripts/tools/harness_local_gate.py",
      "purpose": "Runs the read-only-by-default local finish gate for solo or private Gitea projects without runners: tool tests, Harness cache inventory, verify_all, optional strict release check, read-only memory review, repository/conflict/untracked checks, and separate staged/unstaged diff hygiene and stats. Cache cleanup is explicit and containment checked.",
      "inputs": [
        "Harness/scripts/tools/tests/",
        "Harness/scripts/tools/harness_verify_all.py",
        "Harness/scripts/tools/harness_release_check.py with --release",
        "Harness/scripts/tools/harness_memory_review.py",
        "git diff --check",
        "git diff --cached --check",
        "git diff --stat",
        "git diff --cached --stat",
        "git status --porcelain=v1",
        "git ls-files -u",
        "--release",
        "--skip-tests",
        "--cleanup-caches"
      ],
      "outputs": [
        "local_gate_report",
        "json"
      ],
      "writes_files": "only_with_--cleanup-caches_removes_containment_checked_Harness_python_caches",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_local_gate.py --json --skip-tests"
    },
    {
      "name": "harness_release_check",
      "path": "Harness/scripts/tools/harness_release_check.py",
      "purpose": "Checks template-release hygiene including generated-artifact provenance, sensitive data, caches, symlinks, old layouts, leaked paths, and real work records.",
      "inputs": [
        "Harness/",
        "root text files",
        "Harness/work/cycles/",
        "Harness/config/generated_artifacts.json",
        "--strict"
      ],
      "outputs": [
        "release_hygiene_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_release_check.py --json"
    },
    {
      "name": "harness_release_pack",
      "path": "Harness/scripts/tools/harness_release_pack.py",
      "purpose": "Previews or atomically writes a byte-reproducible clean Harness template ZIP from a required reviewed manifest while excluding local files, symlinks, caches, generated handoffs, and real work records; missing, stale, or invalid manifest data and protected output paths always block writes, while --force can bypass only non-manifest hygiene failures.",
      "inputs": [
        "README.md",
        "AGENTS.md",
        "CLAUDE.md",
        "HARNESS.md",
        "Harness/docs/template/",
        "Harness/",
        "--write",
        "--force",
        "--output"
      ],
      "outputs": [
        "release_file_list",
        "zip_file only with --write",
        "json"
      ],
      "writes_files": "only_with_--write",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_release_pack.py --json"
    },
    {
      "name": "harness_update_plan",
      "path": "Harness/scripts/tools/harness_update_plan.py",
      "purpose": "Uses manifest ownership and an optional install receipt for conservative two-way or hash-based three-way update planning, while preserving project data and transactional review staging.",
      "inputs": [
        "--template",
        "--target",
        "--apply-missing",
        "--stage-review",
        "--overwrite-stage",
        "--accept-receipt",
        "--resolutions",
        "Harness/template/manifest.json",
        "Harness/config/template_receipt.json"
      ],
      "outputs": [
        "classified_update_plan",
        "missing files only with --apply-missing",
        "review copy only with --stage-review",
        "verified install receipt only with --accept-receipt"
      ],
      "writes_files": "only_with_--apply-missing_--stage-review_or_--accept-receipt",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_update_plan.py --target . --json"
    },
    {
      "name": "harness_knowledge",
      "path": "Harness/scripts/tools/harness_knowledge.py",
      "purpose": "Searches retained Harness material with explicit/current paths first, marks invalidated or superseded sections, then reports omitted scope when bounds truncate discovery.",
      "inputs": [
        "--query",
        "--limit",
        "--max-files",
        "--path",
        "Harness/config/docs.json",
        "Harness/docs/",
        "Harness/index/",
        "Harness/work/"
      ],
      "outputs": [
        "knowledge_inventory",
        "ranked_existing_material",
        "omitted_scope_and_broader_query_hint",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_knowledge.py --query \"Harness update\" --json"
    },
    {
      "name": "harness_memory",
      "path": "Harness/scripts/tools/harness_memory.py",
      "purpose": "Maintains optional daily JSONL memory shards with UUID entries, review status changes, pruning diagnostics, and a rebuildable local SQLite search cache.",
      "inputs": [
        "--init",
        "--add",
        "--validate",
        "--promote",
        "--demote",
        "--doctor",
        "--prune",
        "--query",
        "--rebuild",
        "--write",
        "Harness/data/memory/*.jsonl",
        "Harness/data/harness.sqlite"
      ],
      "outputs": [
        "memory_entry",
        "ranked_memory_results",
        "sqlite_cache"
      ],
      "writes_files": "only_with_--init_--add_--rebuild_--promote_--demote_or_--prune_--write",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_memory.py --query \"Harness\" --json"
    },
    {
      "name": "harness_memory_review",
      "path": "Harness/scripts/tools/harness_memory_review.py",
      "purpose": "Reviews changed paths and optional memory shard health before staging, suggesting compact reusable memory candidate categories without writing files.",
      "inputs": [
        "git status --short",
        "Harness/data/memory/*.jsonl",
        "--changed-path"
      ],
      "outputs": [
        "memory_review_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_memory_review.py --json --changed-path HARNESS.md"
    },
    {
      "name": "harness_migration_audit",
      "path": "Harness/scripts/tools/harness_migration_audit.py",
      "purpose": "Audits an older Harness project before migration and reports preserve, update, and cleanup items in read-only mode.",
      "inputs": [
        "--target",
        "target/Harness/work/state.md",
        "target/Harness/work/next.md",
        "target/Harness/work/cycles/",
        "target/Harness/config/project.json",
        "target/Harness/config/docs.json",
        "target/Harness/docs/",
        "target/ProjectDocs/ optional external documents",
        "target/Harness/doc/ legacy project documents",
        "target active docs"
      ],
      "outputs": [
        "migration_audit_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_migration_audit.py --target . --json"
    },
    {
      "name": "harness_state_check",
      "path": "Harness/scripts/tools/harness_state_check.py",
      "purpose": "Checks whether state.md, next.md, tasks, and cycles are compact, current, and free of completed or misplaced history.",
      "inputs": [
        "--target",
        "--strict",
        "Harness/config/record_policy.json",
        "Harness/work/state.md",
        "Harness/work/next.md",
        "Harness/README.md",
        "Harness/work/tasks/",
        "Harness/work/cycles/"
      ],
      "outputs": [
        "state_health_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_state_check.py --target . --json"
    },
    {
      "name": "harness_progress_check",
      "path": "Harness/scripts/tools/harness_progress_check.py",
      "purpose": "Enforces the four-section, 40-line human-facing Progress dashboard contract.",
      "inputs": [
        "Harness/Progress.md",
        "--root"
      ],
      "outputs": [
        "progress_dashboard_health_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_progress_check.py --json"
    },
    {
      "name": "harness_progress_html",
      "path": "Harness/scripts/tools/harness_progress_html.py",
      "purpose": "Writes the tracked Harness/Progress_index.html convenience viewer that loads Harness/Progress.md at view time, and with --serve hosts Harness/ on localhost so the viewer can fetch the live Progress.md (browsers block local fetch over file://).",
      "inputs": [
        "Harness/Progress.md",
        "--write",
        "--serve",
        "--port",
        "--no-browser"
      ],
      "outputs": [
        "Harness/Progress_index.html",
        "html_preview",
        "localhost_live_viewer",
        "json"
      ],
      "writes_files": "only_with_--write",
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_progress_html.py --json"
    },
    {
      "name": "harness_python_check",
      "path": "Harness/scripts/tools/harness_python_check.py",
      "purpose": "Checks Python 3 availability and Unreal Python candidates, and provides manual installation guidance when missing.",
      "inputs": [
        "python --version",
        "py -3 --version",
        "python3 --version",
        "Harness/config/project.json"
      ],
      "outputs": [
        "python_runtime_report",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_python_check.py --json"
    },
    {
      "name": "harness_init_plan",
      "path": "Harness/scripts/tools/harness_init_plan.py",
      "purpose": "Summarizes preservation, fields to fill, and verification commands for new project initialization or template migration.",
      "inputs": [
        "HARNESS.md",
        "Harness/",
        "*.uproject",
        "Harness/config/project.json",
        "Harness/config/docs.json"
      ],
      "outputs": [
        "init_or_migration_plan",
        "json"
      ],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_init_plan.py --json"
    },
    {
      "name": "harness_docs_index",
      "path": "Harness/scripts/tools/harness_docs_index.py",
      "purpose": "Indexes titles and headings in Harness/docs to reduce full-document reading scope.",
