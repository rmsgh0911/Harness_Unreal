{
  "version": 2,
  "note": "This file is a structured helper for the cycle, recording, and tool rules in HARNESS.md. If rules change, update HARNESS.md first and keep this file aligned.",
  "mode": "primary_single_worker",
  "default_max_cycles": 1,
  "cycle_flow": [
    "worker_reads_state_next_and_cycle_log",
    "worker_implements_or_improves",
    "worker_runs_smallest_reasonable_verification",
    "worker_checks_unreal_risks",
    "worker_records_short_cycle_result",
    "worker_decides_continue_or_stop",
    "worker_updates_state_snapshot_if_confirmed",
    "worker_updates_next_items_if_unresolved"
  ],
  "cycle_count_rules": {
    "phrases": [
      "\uc0ac\uc774\ud074",
      "\ubc18\ubcf5",
      "\ucd5c\ub300 N\ud68c",
      "\ucd5c\ub300 N\uc0ac\uc774\ud074",
      "cycle",
      "iterate",
      "up to N times",
      "up to N cycles"
    ],
    "one_cycle_means": [
      "implement_or_improve",
      "smallest_reasonable_verification",
      "self_review",
      "short_record",
      "continue_or_stop_decision"
    ],
    "budget_modes": {
      "exact_count": {
        "max_cycles_is_upper_bound": false,
        "stop_before_max_when_success_criteria_met": false
      },
      "upper_bound": {
        "max_cycles_is_upper_bound": true,
        "stop_before_max_when_success_criteria_met": true
      }
    },
    "exact_count_requests_complete_requested_count": true,
    "do_not_repeat_same_attempt_without_new_evidence": true
  },
  "agent_handoff": {
    "note": "The single-Harness model has no automatic worker switching; a human hands work to another agent at integration or handoff points.",
    "requires_human_assignment": true,
    "record_in_cycle_log": true,
    "generate_brief_windows": "& Harness\\harness.ps1 handoff --request \"<handoff summary>\"",
    "generate_brief_posix": "sh Harness/harness.sh handoff --request \"<handoff summary>\"",
    "recommended_when": [
      "model_quota_exhausted",
      "context_too_large",
      "human_requested_switch"
    ],
    "new_agent_reads_first": [
      "run launcher context --request <current-request> --task <task-id> when a task exists",
      "read only recommended sections; use AGENTS.md manual fallback if context is unavailable",
      "refresh scoped Git evidence and distinguish staged, unstaged, untracked, unknown, and omitted paths",
      "read active task/cycle evidence before continuing or closing; handoff tail is not complete history"
    ],
    "avoid_mid_change_when": [
      "public_api_change",
      "blueprint_exposed_name_change",
      "build_cs_change",
      "save_data_change",
      "binary_asset_change",
      "multi_module_refactor"
    ]
  },
  "recording_rules": {
    "parallel_task_record_pattern": "Harness/work/tasks/<task-id>.md",
    "parallel_cycle_record_pattern": "Harness/work/cycles/<task-id>.md",
    "state_and_next_updated_at_consolidation_points": true,
    "agent_and_timestamp_history_belongs_in_task_or_cycle_files": true,
    "cycle_log_is_short": true,
    "cycle_log_contains": [
      "cycle_number_and_budget_when_repeated",
      "budget_mode_when_repeated",
      "decision_when_repeated",
      "success_criteria_when_repeated",
      "claim_and_evidence_metadata_when_acceptance_matters",
      "changed",
      "verified",
      "remaining"
    ],
    "state_is_not_a_work_log": true,
    "state_keeps_only_latest_confirmed_facts": true,
    "next_keeps_only_unresolved_work": true,
    "avoid_duplicate_state_next_cycles": true
  },
  "closeout": {
    "preview_command": "Harness/harness.cmd close --task <task-id>",
    "write_requires": [
      "latest_cycle_decision_is_stop_success",
      "latest_cycle_has_concrete_verification",
      "latest_cycle_has_no_unresolved_evidence_gap"
    ],
    "status_and_archive_are_transactional": true,
    "warning_debt_policy": "Harness/config/record_policy.json"
  },
  "tool_policy": {
    "agent_may_add_tools": true,
    "default_tool_directory": "Harness/scripts/project",
    "manifest": "Harness/scripts/project/project_tool_manifest.json",
    "standard_tool_directory": "Harness/scripts/tools",
    "standard_manifest": "Harness/scripts/tools/tool_manifest.json",
    "preserve_legacy_registered_custom_tools": true,
    "create_when": [
      "same_exploration_or_verification_will_repeat",
      "output_can_be_short_text_or_json",
      "project_specific_values_can_be_configured",
      "tool_has_single_small_purpose"
    ],
    "avoid_when": [
      "one_off_temporary_conversion",
      "judgment_heavy_refactor",
      "unreal_editor_state_is_required_for_reliable_result",
      "existing_script_option_is_enough"
    ],
    "safety_rules": [
      "default_execution_should_be_read_only",
      "file_writes_require_explicit_option",
      "project_specific_values_should_not_be_hardcoded",
      "register_tools_in_the_manifest_matching_their_ownership",
      "new_or_changed_tools_need_smallest_reasonable_verification"
    ]
  },
  "language_policy": {
    "default_human_language": "ko",
    "agent_facing_harness_language": "en",
    "state_language": "en",
    "cycle_log_language": "en",
    "next_language": "en",
    "progress_language": "ko",
    "progress_path": "Harness/Progress.md",
    "preserve_original_for": [
      "code",
      "identifiers",
      "file_paths",
      "commands",
      "error_messages",
      "logs",
      "quoted_output"
    ]
  },
  "stop_conditions": [
    "same_issue_repeated_twice",
    "build_failed_twice_for_the_same_reason",
    "unexpected_large_diff",
    "unsafe_public_api_or_blueprint_change",
    "human_stop_requested"
  ]
}
